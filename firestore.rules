rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Red de Seguridad Global (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Funciones Primitivas de Validación y RLS (Row-Level Security)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'orjueladavid32@gmail.com' ||
        request.auth.token.email == 'david.orjuela@casadelrey.com' ||
        request.auth.token.email == 'admin@casadelrey.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Ping / connection check
    match /test/connection {
      allow read: if true;
    }

    // Barberos: Catálogo público con nombres, experiencia y disponibilidad
    match /barberos/{barberoId} {
      allow read: if isValidId(barberoId);
      allow write: if isAdmin();
    }

    // Helper de validación de datos para Citas (Individuales y Grupales)
    function isValidCita(data) {
      return (
        (!('idReserva' in data) || isValidId(data.idReserva))
        && (!('tipo' in data) || data.tipo in ['Individual', 'Grupal', 'individual', 'grupal'])
        && (data.estado in [
            'Confirmada', 'confirmada', 
            'En Espera', 'en_espera', 'en_curso', 
            'Cancelada', 'cancelada', 
            'Completada', 'completada'
           ])
        && (data.fecha is string && data.fecha.size() >= 8 && data.fecha.size() <= 20)
        && (data.hora is string && data.hora.size() >= 3 && data.hora.size() <= 20)
        && (
          (data.clienteNombre is string && data.clienteNombre.size() > 0 && data.clienteNombre.size() <= 120) ||
          (data.responsableNombre is string && data.responsableNombre.size() > 0 && data.responsableNombre.size() <= 120)
        )
        && (
          (data.clienteTelefono is string && data.clienteTelefono.size() > 0 && data.clienteTelefono.size() <= 30) ||
          (data.responsableTelefono is string && data.responsableTelefono.size() > 0 && data.responsableTelefono.size() <= 30)
        )
      );
    }

    // Citas: Row-Level Security (RLS)
    // - Un usuario anónimo puede consultar únicamente SU cita por ID específico (get) o crear una nueva reserva válida.
    // - La lectura masiva (list) de citas está estrictamente reservada para personal autenticado (previene raspado de teléfonos de clientes).
    match /citas/{citaId} {
      allow get: if isValidId(citaId);
      allow list: if isSignedIn();
      allow create: if isValidId(citaId) && isValidCita(incoming());
      allow update: if isValidId(citaId) && (
        isAdmin() ||
        (isSignedIn() && isValidCita(incoming())) ||
        (!isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['estado']) && incoming().estado in ['Cancelada', 'cancelada'])
      );
      allow delete: if isAdmin();
    }

    // Cortes Diarios: RLS estricto para colaboradores de barbería
    match /cortes_diarios/{corteId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(corteId)
        && incoming().clienteNombre is string && incoming().clienteNombre.size() <= 120
        && (incoming().barberoId is string || incoming().barberoId is number)
        && incoming().precio is number && incoming().precio >= 0;
      allow update, delete: if isAdmin();
    }

    // Caja y Arqueos diarios: RLS para personal de caja y gerencia
    match /caja_arqueos/{fechaId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(fechaId)
        && incoming().baseInicial is number && incoming().baseInicial >= 0;
      allow delete: if isAdmin();
    }

    // Gastos Operativos: RLS para administración y caja
    match /gastos/{gastoId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(gastoId);
      allow delete: if isAdmin();
    }

    // Usuarios del Sistema: RLS Estricto (Lectura de propio perfil o SuperAdmin)
    match /usuarios/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Productos e Inventario de Barbería
    match /productos/{productoId} {
      allow read: if isValidId(productoId);
      allow create, update: if isSignedIn()
        && isValidId(productoId)
        && incoming().nombre is string && incoming().nombre.size() <= 120
        && incoming().precio is number && incoming().precio >= 0
        && incoming().stock is number;
      allow delete: if isAdmin();
    }
  }
}
