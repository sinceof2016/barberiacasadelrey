rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Red de Seguridad Global (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Funciones Primitivas de Validación y RLS (Row-Level Security)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Administrador: Verificado exclusivamente por documento en /admins/{uid} o rol en /usuarios/{uid}
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['SuperAdmin', 'Administrador']
        )
      );
    }

    // Personal (Staff): Requiere documento de usuario con rol válido (SuperAdmin, Administrador, Cajero)
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['SuperAdmin', 'Administrador', 'Cajero']
        )
      );
    }

    // Consulta la sede asignada en el perfil del usuario autenticado
    function userBranch() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.sucursalAsignada;
    }

    // Valida acceso a una sucursal: Admin y SuperAdmin tienen acceso global ('todas');
    // Cajero solo tiene acceso si su sucursalAsignada coincide exactamente o es 'todas'.
    function canAccessBranch(branchId) {
      return isAdmin() || (
        isStaff() &&
        branchId is string &&
        branchId.size() > 0 &&
        (userBranch() == 'todas' || userBranch() == branchId)
      );
    }

    // Ping / connection check (Solo personal autorizado)
    match /test/connection {
      allow read: if isStaff();
    }

    // Barberos: Catálogo público con nombres, experiencia y disponibilidad
    match /barberos/{barberoId} {
      allow read: if isValidId(barberoId);
      allow write: if isAdmin();
    }

    // Helper de validación de estructura de datos para Citas
    function isValidCita(data) {
      return (
        (!('idReserva' in data) || isValidId(data.idReserva))
        && (!('tipo' in data) || data.tipo in ['Individual', 'Grupal', 'individual', 'grupal'])
        && (data.estado in [
            'Confirmada', 'confirmada', 
            'En Espera', 'en_espera', 'en_curso', 
            'Cancelada', 'cancelada', 
            'Completada', 'completada'
           ])
        && (data.fecha is string && data.fecha.size() >= 8 && data.fecha.size() <= 20)
        && (data.hora is string && data.hora.size() >= 3 && data.hora.size() <= 20)
        && (
          (data.clienteNombre is string && data.clienteNombre.size() > 0 && data.clienteNombre.size() <= 120) ||
          (data.responsableNombre is string && data.responsableNombre.size() > 0 && data.responsableNombre.size() <= 120)
        )
        && (
          (data.clienteTelefono is string && data.clienteTelefono.size() > 0 && data.clienteTelefono.size() <= 60) ||
          (data.responsableTelefono is string && data.responsableTelefono.size() > 0 && data.responsableTelefono.size() <= 60)
        )
      );
    }

    // Validación estricta para creación pública de citas (solo estados iniciales y campos autorizados)
    function isValidCitaCreate(data) {
      return isValidCita(data)
        && (data.estado in ['Confirmada', 'En Espera', 'confirmada', 'en_espera'])
        && (data.sucursalId is string && data.sucursalId.size() > 0)
        && data.keys().hasOnly([
          'idReserva', 'tipo', 'clienteNombre', 'clienteTelefono', 'clienteTelefonoEncrypted',
          'clienteEmail', 'servicioId', 'servicio', 'servicioNombre', 'precio',
          'barberoId', 'barberoNombre', 'sucursalId', 'sucursalNombre', 'fecha', 'hora',
          'estado', 'metodoPago', 'corteId', 'responsableNombre', 'responsableTelefono',
          'responsableTelefonoEncrypted', 'responsableEmail', 'totalPersonas', 'detalles',
          'notas', 'notasEncrypted', 'creadoEn', 'fechaGuardado', 'fechaActualizacion',
          'googleCalendarEventId', 'googleCalendarHtmlLink'
        ]);
    }

    // Citas: Row-Level Security (RLS)
    // - Un usuario anónimo puede consultar únicamente SU cita por ID específico (get) o crear una nueva reserva válida.
    // - La lectura masiva (list) de citas está estrictamente reservada para personal del negocio (isStaff / isAdmin) según su sede.
    match /citas/{citaId} {
      allow get: if isValidId(citaId);
      allow list: if isStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidId(citaId) && isValidCitaCreate(incoming());
      allow update: if isValidId(citaId) && (
        isAdmin() ||
        (isStaff() && isValidCita(incoming()) && canAccessBranch(existing().sucursalId) && canAccessBranch(incoming().sucursalId)) ||
        (!isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['estado']) && incoming().estado in ['Cancelada', 'cancelada'])
      );
      allow delete: if isAdmin();
    }

    // Cortes Diarios: RLS estricto para colaboradores de barbería con rol y sede verificada
    match /cortes_diarios/{corteId} {
      allow get, list: if canAccessBranch(resource.data.sucursalId);
      allow create: if isStaff()
        && isValidId(corteId)
        && incoming().clienteNombre is string && incoming().clienteNombre.size() <= 120
        && (incoming().barberoId is string || incoming().barberoId is number)
        && incoming().precio is number && incoming().precio >= 0
        && canAccessBranch(incoming().sucursalId);
      allow update: if isAdmin() || (
        isStaff() && canAccessBranch(existing().sucursalId) && canAccessBranch(incoming().sucursalId)
      );
      allow delete: if isAdmin();
    }

    // Caja y Arqueos diarios: RLS para personal de caja y gerencia con control por sede
    match /caja_arqueos/{fechaId} {
      allow get, list: if canAccessBranch(resource.data.sucursalId);
      allow create: if isStaff()
        && isValidId(fechaId)
        && incoming().baseInicial is number && incoming().baseInicial >= 0
        && canAccessBranch(incoming().sucursalId);
      allow update: if isAdmin() || (
        isStaff() && canAccessBranch(existing().sucursalId) && canAccessBranch(incoming().sucursalId)
      );
      allow delete: if isAdmin();
    }

    // Gastos Operativos: RLS para administración y caja con control por sede
    match /gastos/{gastoId} {
      allow get, list: if canAccessBranch(resource.data.sucursalId);
      allow create: if isStaff()
        && isValidId(gastoId)
        && canAccessBranch(incoming().sucursalId);
      allow update: if isAdmin() || (
        isStaff() && canAccessBranch(existing().sucursalId) && canAccessBranch(incoming().sucursalId)
      );
      allow delete: if isAdmin();
    }

    // Usuarios del Sistema: RLS Estricto (Lectura de propio perfil o SuperAdmin)
    match /usuarios/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Productos e Inventario de Barbería
    match /productos/{productoId} {
      allow read: if isValidId(productoId);
      allow create, update: if isStaff()
        && isValidId(productoId)
        && incoming().nombre is string && incoming().nombre.size() <= 120
        && incoming().precio is number && incoming().precio >= 0
        && incoming().stock is number;
      allow delete: if isAdmin();
    }
  }
}
