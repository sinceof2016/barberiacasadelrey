# Configuración Segura de Barbería La Casa del Rey
# Duplica este archivo como .env y rellena las variables de entorno.
# NUNCA subas archivos .env con credenciales reales a GitHub.

# Configuración de Servidor
PORT=3000
NODE_ENV=development

# Seguridad & Expiración de Sesión (en minutos)
SESSION_EXPIRY_MINUTES=120
SESSION_INACTIVITY_MINUTES=30

# Llave Criptográfica para Encriptación de Base de Datos (AES-256-GCM)
DATABASE_ENCRYPTION_KEY=
VITE_DATABASE_ENCRYPTION_SALT=

# Rate Limiting & Limitación por IP
RATE_LIMIT_GLOBAL_MAX=150
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
IP_RATE_LIMIT_MAX_PER_MINUTE=120
IP_BOOKING_RATE_LIMIT_MAX=10
IP_LOGIN_MAX_ATTEMPTS=5
IP_BLACKLIST=
IP_WHITELIST=127.0.0.1,::1

# CORS (Cross-Origin Resource Sharing)
# Lista de orígenes permitidos separados por comas. Dejar vacío para permitir localhost, 127.0.0.1 y *.run.app automáticamente.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Firebase / Firestore Cloud Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=

# Notificaciones WhatsApp de Reservas (Oficial Barbería La Casa del Rey: +57 312 644 1665)
WHATSAPP_NOTIFY_NUMBER=
VITE_WHATSAPP_NOTIFY_NUMBER=
WHATSAPP_SECONDARY_NUMBERS=
WHATSAPP_PROVIDER=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_GATEWAY_URL=
