{
  "entities": {
    "Cita": {
      "title": "Cita",
      "description": "Reserva de turno en la barbería para cliente individual o grupal",
      "type": "object",
      "properties": {
        "idReserva": { "type": "string", "maxLength": 50 },
        "tipo": { "type": "string", "enum": ["Individual", "Grupal", "individual", "grupal"] },
        "clienteNombre": { "type": "string", "maxLength": 120 },
        "clienteTelefono": { "type": "string", "maxLength": 30 },
        "clienteEmail": { "type": "string", "maxLength": 150 },
        "responsableNombre": { "type": "string", "maxLength": 120 },
        "responsableTelefono": { "type": "string", "maxLength": 30 },
        "responsableEmail": { "type": "string", "maxLength": 150 },
        "servicioId": { "type": "number" },
        "servicio": { "type": "string", "maxLength": 120 },
        "barberoId": { "type": "string", "maxLength": 50 },
        "barberoNombre": { "type": "string", "maxLength": 100 },
        "precio": { "type": "number" },
        "fecha": { "type": "string", "maxLength": 20 },
        "hora": { "type": "string", "maxLength": 20 },
        "duracionMinutos": { "type": "number" },
        "estado": { "type": "string", "enum": ["Confirmada", "En Espera", "Cancelada", "confirmada", "cancelada", "completada", "en_curso"] },
        "totalPersonas": { "type": "number" },
        "sucursalId": { "type": "string", "maxLength": 50 },
        "sucursalNombre": { "type": "string", "maxLength": 100 },
        "notas": { "type": "string", "maxLength": 500 },
        "origen": { "type": "string", "maxLength": 50 },
        "folio": { "type": "string", "maxLength": 30 },
        "creadoEn": { "type": "string" },
        "fechaGuardado": { "type": "string" }
      },
      "required": ["idReserva", "fecha", "hora", "estado"]
    },
    "Barbero": {
      "title": "Barbero",
      "description": "Perfil del barbero maestro de la barbería",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 100 },
        "especialidad": { "type": "string", "maxLength": 120 },
        "experienciaAnos": { "type": "number" },
        "disponible": { "type": "boolean" },
        "calificacion": { "type": "number" },
        "fotoUrl": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "nombre", "especialidad", "disponible"]
    },
    "CorteDiario": {
      "title": "CorteDiario",
      "description": "Registro de corte o servicio cobrado para liquidación y arqueo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barberoId": { "type": "string" },
        "barberoNombre": { "type": "string", "maxLength": 100 },
        "clienteNombre": { "type": "string", "maxLength": 120 },
        "servicio": { "type": "string", "maxLength": 120 },
        "precio": { "type": "number" },
        "porcentajeBarbero": { "type": "number" },
        "pagoBarbero": { "type": "number" },
        "pagoCasa": { "type": "number" },
        "metodoPago": { "type": "string", "enum": ["Efectivo", "Nequi", "DaviPlata", "Tarjeta", "Transferencia"] },
        "propina": { "type": "number" },
        "fecha": { "type": "string", "maxLength": 20 },
        "hora": { "type": "string", "maxLength": 20 },
        "notas": { "type": "string", "maxLength": 300 }
      },
      "required": ["barberoId", "clienteNombre", "servicio", "precio", "metodoPago", "fecha"]
    },
    "CajaArqueo": {
      "title": "CajaArqueo",
      "description": "Registro de base inicial o arqueo diario de caja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string", "maxLength": 20 },
        "hora": { "type": "string", "maxLength": 20 },
        "timestamp": { "type": "string" },
        "sucursalId": { "type": "string", "maxLength": 50 },
        "sucursalNombre": { "type": "string", "maxLength": 100 },
        "usuarioId": { "type": "string", "maxLength": 50 },
        "usuarioNombre": { "type": "string", "maxLength": 100 },
        "baseInicial": { "type": "number" },
        "entradasEfectivo": { "type": "number" },
        "salidasEfectivoGastos": { "type": "number" },
        "salidasEfectivoComisiones": { "type": "number" },
        "saldoEsperado": { "type": "number" },
        "efectivoContado": { "type": "number" },
        "diferencia": { "type": "number" },
        "estado": { "type": "string", "enum": ["CUADRADO", "SOBRANTE", "FALTANTE"] },
        "observaciones": { "type": "string", "maxLength": 500 },
        "actualizadoPor": { "type": "string", "maxLength": 100 }
      },
      "required": ["fecha", "baseInicial"]
    },
    "ProductoInventario": {
      "title": "ProductoInventario",
      "description": "Catálogo de productos de barbería para venta y control de inventario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 120 },
        "categoria": { "type": "string", "enum": ["Pomadas", "Ceras", "Geles", "Perfumería", "Cuidado Barba", "Otros"] },
        "precio": { "type": "number" },
        "costo": { "type": "number" },
        "stock": { "type": "number" },
        "stockMinimo": { "type": "number" },
        "sku": { "type": "string", "maxLength": 50 },
        "marca": { "type": "string", "maxLength": 80 },
        "descripcion": { "type": "string", "maxLength": 300 },
        "activo": { "type": "boolean" },
        "actualizadoEn": { "type": "string" }
      },
      "required": ["id", "nombre", "categoria", "precio", "stock"]
    },
    "Usuario": {
      "title": "Usuario",
      "description": "Cuenta de usuario del sistema (SuperAdmin, Administrador, Cajero)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 },
        "rol": { "type": "string", "enum": ["SuperAdmin", "Administrador", "Cajero"] },
        "sucursalAsignada": { "type": "string", "maxLength": 50 },
        "puedeVerApi": { "type": "boolean" },
        "activo": { "type": "boolean" },
        "creadoEn": { "type": "string" }
      },
      "required": ["id", "nombre", "email", "rol"]
    },
    "Gasto": {
      "title": "Gasto",
      "description": "Registro de egreso operativo de la barbería",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string", "maxLength": 20 },
        "hora": { "type": "string", "maxLength": 20 },
        "concepto": { "type": "string", "maxLength": 200 },
        "categoria": { "type": "string", "maxLength": 80 },
        "monto": { "type": "number" },
        "metodoPago": { "type": "string", "maxLength": 50 },
        "sucursalId": { "type": "string", "maxLength": 50 },
        "creadoEn": { "type": "string" }
      },
      "required": ["id", "fecha", "concepto", "monto", "metodoPago"]
    }
  },
  "firestore": {
    "/citas/{citaId}": {
      "schema": "Cita",
      "description": "Colección de reservas de clientes individuales y grupales"
    },
    "/barberos/{barberoId}": {
      "schema": "Barbero",
      "description": "Colección de barberos del salón y disponibilidad"
    },
    "/cortes_diarios/{corteId}": {
      "schema": "CorteDiario",
      "description": "Colección de servicios realizados y comisiones registradas"
    },
    "/caja_arqueos/{fecha}": {
      "schema": "CajaArqueo",
      "description": "Colección de bases iniciales y cierres de caja por fecha"
    },
    "/productos/{productoId}": {
      "schema": "ProductoInventario",
      "description": "Colección de inventario de productos de venta de la barbería"
    },
    "/usuarios/{userId}": {
      "schema": "Usuario",
      "description": "Colección de perfiles de usuario con RLS y permisos"
    },
    "/gastos/{gastoId}": {
      "schema": "Gasto",
      "description": "Colección de gastos operativos de la sede con RLS"
    }
  }
}
